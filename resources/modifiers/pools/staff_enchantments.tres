[gd_resource type="Resource" script_class="ModifierPool" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/modifier_pool.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/weighted_modifier_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://resources/modifiers/definitions/item_specific/ember_bolt_damage.tres" id="3_ember"]

[sub_resource type="Resource" id="EmberStaffEntry"]
