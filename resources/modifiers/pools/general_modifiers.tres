[gd_resource type="Resource" script_class="ModifierPool" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/modifier_pool.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/weighted_modifier_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://resources/modifiers/definitions/general/maximum_vitality.tres" id="3_vitality"]
[ext_resource type="Resource" path="res://resources/modifiers/definitions/general/maximum_mana.tres" id="4_mana"]
[ext_resource type="Resource" path="res://resources/modifiers/definitions/general/attack_power.tres" id="5_attack"]
[ext_resource type="Resource" path="res://resources/modifiers/definitions/general/armor.tres" id="6_armor"]
[ext_resource type="Resource" path="res://resources/modifiers/definitions/general/mana_recovery.tres" id="7_recovery"]

[sub_resource type="Resource" id="VitalityEntry"]
script = ExtResource("2_entry")
modifier = ExtResource("3_vitality")
weight = 20.0

[sub_resource type="Resource" id="ManaEntry"]
script = ExtResource("2_entry")
modifier = ExtResource("4_mana")
weight = 20.0

[sub_resource type="Resource" id="AttackEntry"]
script = ExtResource("2_entry")
modifier = ExtResource("5_attack")
weight = 20.0

[sub_resource type="Resource" id="ArmorEntry"]
script = ExtResource("2_entry")
modifier = ExtResource("6_armor")
weight = 20.0

[sub_resource type="Resource" id="RecoveryEntry"]
script = ExtResource("2_entry")
modifier = ExtResource("7_recovery")
weight = 20.0

[resource]
script = ExtResource("1_pool")
pool_id = &"general"
display_name = "General modifiers"
entries = Array[ExtResource("2_entry")]([SubResource("VitalityEntry"), SubResource("ManaEntry"), SubResource("AttackEntry"), SubResource("ArmorEntry"), SubResource("RecoveryEntry")])
